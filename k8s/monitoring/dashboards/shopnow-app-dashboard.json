{
  "title": "ShopNow Application Monitoring",
  "tags": ["shopnow", "application"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Pods Running",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(kube_pod_status_phase{namespace=\"shopnow\", phase=\"Running\"} == 1)", "legendFormat": "Running" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } }
    },
    {
      "id": 2,
      "title": "Pods Not Ready",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "count(kube_pod_status_phase{namespace=\"shopnow\", phase=~\"Failed|Pending|Unknown\"} == 1)", "legendFormat": "Not Ready" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 3,
      "title": "Total Restarts (Last Hour)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"shopnow\"}[1h]))", "legendFormat": "Restarts" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 4,
      "title": "Backend HPA Replicas",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"shopnow\", horizontalpodautoscaler=\"backend-hpa\"}", "legendFormat": "Current Replicas" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": 0 }] } } }
    },
    {
      "id": 5,
      "title": "CPU Usage by Pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"shopnow\", container!=\"\"}[5m])) by (pod)", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 6,
      "title": "Memory Usage by Pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "sum(container_memory_working_set_bytes{namespace=\"shopnow\", container!=\"\"}) by (pod)", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 7,
      "title": "Deployment Available vs Desired Replicas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "kube_deployment_status_replicas_available{namespace=\"shopnow\"}", "legendFormat": "{{deployment}} available" },
        { "expr": "kube_deployment_spec_replicas{namespace=\"shopnow\"}", "legendFormat": "{{deployment}} desired" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 5 } } }
    },
    {
      "id": 8,
      "title": "Pod Restarts by Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"shopnow\"}[5m])) by (pod, container)", "legendFormat": "{{pod}} / {{container}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } } }
    },
    {
      "id": 9,
      "title": "Network Receive by Pod",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"shopnow\"}[5m])) by (pod)", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 10,
      "title": "Network Transmit by Pod",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"shopnow\"}[5m])) by (pod)", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 11,
      "title": "Jenkins Health Score",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 27 },
      "targets": [{ "expr": "default_jenkins_builds_health_score{jenkins_job=\"capstone-devops-pipeline\"}", "legendFormat": "Health" }],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] } } }
    },
    {
      "id": 12,
      "title": "Last Build Result",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 27 },
      "targets": [{ "expr": "default_jenkins_builds_last_build_result{jenkins_job=\"capstone-devops-pipeline\"}", "legendFormat": "Success = 1" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 13,
      "title": "Total Builds",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 27 },
      "targets": [{ "expr": "default_jenkins_builds_available_builds_count{jenkins_job=\"capstone-devops-pipeline\"}", "legendFormat": "Builds" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": 0 }] } } }
    },
    {
      "id": 14,
      "title": "Last Build Duration",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 27 },
      "targets": [{ "expr": "default_jenkins_builds_last_build_duration_milliseconds{jenkins_job=\"capstone-devops-pipeline\"}", "legendFormat": "Duration" }],
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } }
    },
    {
      "id": 15,
      "title": "Build Duration Trend",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 31 },
      "targets": [{ "expr": "default_jenkins_builds_last_build_duration_milliseconds{jenkins_job=\"capstone-devops-pipeline\"}", "legendFormat": "{{jenkins_job}}" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    }
  ]
}
